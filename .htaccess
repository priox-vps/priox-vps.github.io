# Immer die HTML-Startseite ausliefern. Sicherheitsnetz fuer den Fall, dass
# im Webspace noch eine index.php der alten WordPress-Installation liegt -
# ohne diese Zeile wuerde Strato weiter die alte Seite zeigen.
DirectoryIndex index.html index.php

ErrorDocument 404 /404.html

Options -Indexes

# www.deal-makers.de auf deal-makers.de umleiten.
# Bisher hat WordPress das erledigt. Nach dem Upload liegt dort nur noch HTML,
# also muss die Weiterleitung hier stehen - sonst waere die Seite unter zwei
# Adressen mit identischem Inhalt erreichbar (Duplikat fuer Google).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http auf https zwingen. Bisher hat das WordPress erledigt - nach dem Upload
  # liegt dort nur noch HTML, also muss die Regel hier stehen. Beide Bedingungen
  # muessen zutreffen (UND), sonst entsteht bei Strato eine Endlosschleife,
  # wenn die Verschluesselung vorgelagert beendet wird.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://deal-makers.de%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.deal-makers\.de$ [NC]
  RewriteRule ^(.*)$ https://deal-makers.de/$1 [R=301,L]
</IfModule>

# Alte Adressen der bisherigen Website dauerhaft (301) auf die neuen Seiten umleiten.
# Ohne diese Zeilen landen Besucher und Google nach dem Upload auf einer Fehlerseite.
# Quelle der Liste: die Sitemaps der bisherigen WordPress-Seite, abgerufen am
# 24.09.2026 (page-, post- und category-sitemap = 25 Adressen).

# -- Seiten, die es unter neuem Namen gibt -------------------------------------
RedirectMatch 301 ^/vertriebsagentur/?$               /b2b-vertriebsagentur/
RedirectMatch 301 ^/vertriebscoaching/?$              /vertriebstraining-b2b/
RedirectMatch 301 ^/verkaufstraining-online/?$        /vertriebstraining-b2b/
RedirectMatch 301 ^/training-coaching/?$              /vertriebstraining-b2b/
RedirectMatch 301 ^/performance-marketing-agentur/?$  /leadgenerierung-agentur/
RedirectMatch 301 ^/conversion-optimierung-agentur/?$ /leadgenerierung-agentur/
RedirectMatch 301 ^/marketing-automation-agentur/?$   /leadgenerierung-agentur/
RedirectMatch 301 ^/leadgenerierung/?$                /leadgenerierung-agentur/
RedirectMatch 301 ^/emotional-resonance/?$            /warum-wir/
RedirectMatch 301 ^/unternehmen/?$                    /warum-wir/
RedirectMatch 301 ^/mimikresonanz/?$                  /verkaufspsychologie/
RedirectMatch 301 ^/vertrieb/?$                       /b2b-vertrieb/
RedirectMatch 301 ^/marketing/?$                      /leistungen/
RedirectMatch 301 ^/vertriebler-gesucht/?$            /kontakt/
RedirectMatch 301 ^/haftungsausschluss/?$             /impressum/

# -- Aeltere Seiten, die nicht mehr in der Sitemap standen ---------------------
# Nachgetragen am 25.09.2026: Nach dem Livegang mit dem Internet-Archiv geprueft.
# Diese 16 Adressen waren aus der WordPress-Sitemap bereits entfernt, sind aber
# noch verlinkt und Google noch bekannt - ohne diese Zeilen liefen sie ins Leere.
RedirectMatch 301 ^/vertriebstraining/?$              /vertriebstraining-b2b/
RedirectMatch 301 ^/vertriebstraining-online/?$       /vertriebstraining-b2b/
RedirectMatch 301 ^/lp-vertriebstraining/?$           /vertriebstraining-b2b/
RedirectMatch 301 ^/high-end-closer/?$                /vertriebstraining-b2b/
RedirectMatch 301 ^/vertriebsberatung-4-0/?$          /vertriebsberatung/
RedirectMatch 301 ^/vertriebsagentur-4-0/?$           /b2b-vertriebsagentur/
RedirectMatch 301 ^/sales-agency/?$                   /b2b-vertriebsagentur/
RedirectMatch 301 ^/b2b-leadgenerierung/?$            /leadgenerierung-agentur/
RedirectMatch 301 ^/leadmaschine/?$                   /leadgenerierung-agentur/
RedirectMatch 301 ^/linkedin-agentur/?$               /leadgenerierung-agentur/
RedirectMatch 301 ^/mimikresonanz3/?$                 /verkaufspsychologie/
RedirectMatch 301 ^/die-dealmakers/?$                 /warum-wir/
RedirectMatch 301 ^/author/.*$                        /warum-wir/
RedirectMatch 301 ^/termin/?$                         /kontakt/
RedirectMatch 301 ^/ai-recruiting/?$                  /leistungen/
RedirectMatch 301 ^/vertriebspower/?$                 /leistungen/

# -- Blog und Kategorien ------------------------------------------------------
RedirectMatch 301 ^/blog/?$                           /ratgeber/
RedirectMatch 301 ^/category/vertrieb/?$              /ratgeber/
RedirectMatch 301 ^/category/.*$                      /ratgeber/

# -- Reste der WordPress-Installation -----------------------------------------
# Diese Adressen existieren nach dem Upload nicht mehr. Statt einer Fehlerseite
# bekommen Besucher die Startseite.
RedirectMatch 301 ^/jet-menu/.*$                      /
RedirectMatch 301 ^/wp-admin/?.*$                     /
RedirectMatch 301 ^/feed/?$                           /ratgeber/
RedirectMatch 301 ^/(.*)/feed/?$                      /ratgeber/
# Die alten Sitemap-Adressen kennt Google noch - auf die neue zeigen lassen.
RedirectMatch 301 ^/sitemap_index\.xml$               /sitemap.xml
RedirectMatch 301 ^/(page|post|category|jet-menu)-sitemap\.xml$ /sitemap.xml

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

# WebP-Bilder: manche Apache-Installationen kennen den Typ nicht von Haus aus.
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
